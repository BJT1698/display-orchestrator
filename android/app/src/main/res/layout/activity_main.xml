<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_cast"
            android:drawablePadding="8dp"
            android:drawableTint="@color/muted"
            android:gravity="center_vertical"
            android:text="@string/brand"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:text="@string/title"
            android:textColor="@color/ink"
            android:textSize="30sp" />

        <!-- Server: the address once, then a one-line summary -->
        <LinearLayout
            android:id="@+id/serverForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/Label" android:text="@string/server_label" />

            <EditText
                android:id="@+id/server"
                style="@style/Field"
                android:hint="@string/server_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri" />

            <Button
                android:id="@+id/connect"
                style="@style/ButtonPrimary"
                android:text="@string/connect" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/serverLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/linkTally"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/tally" />

            <TextView
                android:id="@+id/serverText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/changeServer"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:text="@string/change"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Why the last request ended -->
        <TextView
            android:id="@+id/notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/panel"
            android:padding="14dp"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <!-- Request -->
        <LinearLayout
            android:id="@+id/requestForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Body"
                android:layout_marginTop="16dp"
                android:text="@string/intro" />

            <TextView style="@style/Label" android:text="@string/name_label" />

            <EditText
                android:id="@+id/name"
                style="@style/Field"
                android:hint="@string/name_hint"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="40" />

            <TextView style="@style/Label" android:text="@string/screen_label" />

            <Spinner
                android:id="@+id/screen"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/control"
                android:popupBackground="@color/raised"
                android:spinnerMode="dropdown" />

            <Button
                android:id="@+id/ask"
                style="@style/ButtonPrimary"
                android:text="@string/ask" />
        </LinearLayout>

        <!-- Waiting for an operator -->
        <LinearLayout
            android:id="@+id/pending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/tally"
                    android:backgroundTint="@color/caution" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/waiting"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-condensed-medium"
                android:letterSpacing="0.06"
                android:textColor="@color/ink"
                android:textSize="56sp" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:text="@string/waiting_hint" />
        </LinearLayout>

        <!-- Approved: start and stop the stream -->
        <LinearLayout
            android:id="@+id/approved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/castTally"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/tally" />

                <TextView
                    android:id="@+id/approvedText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/castText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <Button
                android:id="@+id/share"
                style="@style/ButtonPrimary"
                android:text="@string/start_sharing" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="16dp"
                android:text="@string/approved_hint"
                android:textColor="@color/faint"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- The signage server is on the office network and usually reached over plain http -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- An internal CA the user installed (e.g. caddy's), for https addresses -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

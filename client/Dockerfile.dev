# ==============================================================================
# Development Kiosk Client (Windowed on Host X11 + Remote DevTools Port 9222)
# ==============================================================================
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV DISPLAY=:0
ENV AGENT_PORT=9090
ENV SERVER_URL=ws://server:8080/ws
ENV CACHE_DIR=/cache
ENV WINDOWED=true
ENV WINDOW_WIDTH=1280
ENV WINDOW_HEIGHT=720

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    chromium-sandbox \
    cage \
    xvfb \
    x11-xserver-utils \
    unclutter \
    curl \
    ca-certificates \
    python3 \
    python3-pip \
    python3-websockets \
    libgl1-mesa-dri \
    libgl1-mesa-glx \
    mesa-utils \
    fonts-liberation \
    fonts-dejavu \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mkdir -p /cache /cache/media /tmp/chrome-dev-profile

COPY agent/ /app/client/agent/
COPY viewer/ /app/client/viewer/

VOLUME ["/cache"]

EXPOSE 9090 9222

CMD ["sh", "-c", "python3 /app/client/agent/main.py & sleep 1; exec chromium --no-sandbox --disable-dev-shm-usage --remote-debugging-port=9222 --remote-debugging-address=0.0.0.0 --user-data-dir=/tmp/chrome-dev-profile --window-size=1280,720 --window-position=50,50 --no-first-run --no-default-browser-check --disable-session-crashed-bubble --disable-infobars --autoplay-policy=no-user-gesture-required --app=http://localhost:9090"]
